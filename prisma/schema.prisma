generator client {
  provider = "prisma-client-js"
}

datasource grupoMorizDB {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Silo {
  id         Int             @id @default(autoincrement())
  name       String
  sensorCode String          @unique
  minLevel   Decimal         @default(0)
  maxLevel   Decimal         @default(200)
  levelData  SiloLevelData[]

  @@map("silo")
}

model SiloLevelData {
  id              BigInt   @id @default(autoincrement())
  levelValue      Decimal
  levelPercentage Decimal
  timestamp       DateTime @default(now())
  siloId          Int
  silo            Silo     @relation(fields: [siloId], references: [id], onDelete: Cascade)

  @@map("silo_level_data")
}

model EnvironmentalMetrics {
  id         Int                 @id @default(autoincrement())
  name       String
  sensorCode String              @unique
  data       EnvironmentalData[]

  @@map("environmental_metrics")
}

model EnvironmentalData {
  id          BigInt               @id @default(autoincrement())
  temperature Decimal
  humidity    Decimal
  timestamp   DateTime             @grupoMorizDB.Timestamptz(6)
  metricsId   Int
  metrics     EnvironmentalMetrics @relation(fields: [metricsId], references: [id], onDelete: Cascade)

  @@map("environmental_data")
}

enum Role {
  ADMIN
  VIEWER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())

  @@map("users")
}
